@model IEnumerable<TaskManagementSystem.Models.TaskItem>
@{
    ViewData["Title"] = "Tasks";
    var selectedSort = (ViewData["SortBy"] as string) ?? "date_desc";
    var currentAppUserId = ViewData["CurrentAppUserId"] as int?;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h2 class="mb-0">Tasks</h2>
    <div class="d-flex gap-2 align-items-center">
        <form method="get" asp-action="Index" class="d-flex gap-2 align-items-center">
            <label for="sortBy" class="form-label mb-0">Sort</label>
            <select id="sortBy" name="sortBy" class="form-select form-select-sm">
                @if (selectedSort == "date_desc")
                {
                    <option value="date_desc" selected>Newest first</option>
                }
                else
                {
                    <option value="date_desc">Newest first</option>
                }
                @if (selectedSort == "date_asc")
                {
                    <option value="date_asc" selected>Oldest first</option>
                }
                else
                {
                    <option value="date_asc">Oldest first</option>
                }
                @if (selectedSort == "priority_asc")
                {
                    <option value="priority_asc" selected>Priority low to high</option>
                }
                else
                {
                    <option value="priority_asc">Priority low to high</option>
                }
                @if (selectedSort == "priority_desc")
                {
                    <option value="priority_desc" selected>Priority high to low</option>
                }
                else
                {
                    <option value="priority_desc">Priority high to low</option>
                }
            </select>
            <button type="submit" class="btn btn-sm btn-outline-secondary">Apply</button>
        </form>
        <a asp-action="Create" class="btn btn-primary">Create New</a>
    </div>
</div>

@if (!Model.Any())
{
    <p class="text-muted">No tasks found.</p>
}
else
{
    <table class="table table-bordered table-hover">
        <thead class="table-light">
            <tr>
                <th>Title</th>
                <th>Description</th>
                <th>Priority</th>
                <th>Assigned User</th>
                <th>Created By</th>
                <th>Created At</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Title</td>
                    <td>@item.Description</td>
                    <td>
                        <span class="priority-label priority-@item.Priority.ToString().ToLowerInvariant()">
                            @item.Priority
                        </span>
                    </td>
                    <td>@item.User.Name</td>
                    <td>@(item.CreatedBy?.Username ?? "-")</td>
                    <td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        @if (item.CreatedByAppUserId != null && item.CreatedByAppUserId == currentAppUserId)
                        {
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary me-1">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
